{
  "id": "/",
  "name": "today — Say it naturally",
  "short_name": "today",
  "description": "Meaning-first translation that preserves tone and natural language.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#12100F",
  "theme_color": "#12100F",
  "orientation": "any",
  "lang": "en",
  "dir": "auto",
  "handle_links": "preferred",
  "edge_side_panel": { "preferred_width": 420 },
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "launch_handler": { "client_mode": "navigate-existing" },
  "prefer_related_applications": false,
  "categories": ["productivity", "utilities", "education"],
  "shortcuts": [
    {
      "name": "New Translation",
      "short_name": "Translate",
      "description": "Start a fresh translation",
      "url": "/?action=new",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Saved Phrases",
      "short_name": "Saved",
      "description": "Review your saved phrasebook",
      "url": "/?action=saved",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Translation Statistics",
      "short_name": "Stats",
      "description": "View language statistics and moments",
      "url": "/stats",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-monochrome-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ]
}
