# Server-side secrets. Never commit real values, never expose them to the client:
# only files ending in `.server.ts` (or route handlers) read these.
#
# Translation. At least one is required for the app to translate.
OPENCODE_API_KEY=        # Luna (paused: LUNA_ENABLED=false in src/lib/translation/types.ts)
DEEPSEEK_API_KEY=        # writes every translation, reviews Luna's, and powers the second pass

# Voice and dictation. Optional: without them the app falls back to the device voice
# and hides dictation, and says so in the interface.
GEMINI_API_KEY=          # /api/speak — streamed studio voice
ELEVENLABS_API_KEY=      # /api/eleven-speak — timestamped voice with exact read-along
ASSEMBLYAI_API_KEY=      # temporary tokens for the microphone
