# Server-side secrets. Never commit real values, never expose them to the client:
# only files ending in `.server.ts` (or route handlers) read these. This file is the
# template; copy it to .env (gitignored) and fill the values locally.
#
# Translation. At least one is required for the app to translate.
# Luna is paused in src/lib/translation/types.ts (LUNA_ENABLED=false).
OPENCODE_API_KEY=
# Writes every translation, reviews Luna's, and powers the second pass and enrichment.
DEEPSEEK_API_KEY=

# Voice and dictation. Optional: without them the app falls back to the device voice
# and hides dictation, and says so in the interface.
# /api/speak — streamed studio voice
GEMINI_API_KEY=
# /api/eleven-speak — timestamped voice with exact read-along
ELEVENLABS_API_KEY=
# short-lived tokens for the microphone
ASSEMBLYAI_API_KEY=
