{
  "name": "today-translator",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/build-headers.mjs",
    "build:dev": "vite build --mode development",
    "preview": "node scripts/serve-build.mjs",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "python3 tests/e2e/smoke.py",
    "test:e2e:nav": "python3 tests/e2e/navigation_stability.py",
    "test:e2e:pwa": "python3 tests/e2e/pwa_navigation.py",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "npm run typecheck && npm run lint -- --max-warnings 0 && npm run test && npm run check:contrast && npm run check:docs",
    "og": "node scripts/make-og.mjs",
    "format:check": "prettier --check .",
    "build:native:web": "vite build --config vite.native.config.ts && node scripts/prepare-native-web.mjs",
    "cap:sync": "npm run build:native:web && cap sync android",
    "android:assembleDebug": "cd android && ./gradlew :app:assembleDebug",
    "android:assembleRelease": "cd android && ./gradlew :app:assembleRelease",
    "android:test": "cd android && ./gradlew :app:testDebugUnitTest"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@lovable.dev/vite-tanstack-config": "2.27.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "wawoff2": "^2.0.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "description": "Meaning-first Arabic–German translator: tone, dialect and nuance preserved, private by design.",
  "homepage": "https://fluently.today",
  "repository": {
    "type": "git",
    "url": "https://github.com/alhibi/deep-meaning-translate.git"
  },
  "version": "1.0.1"
}
