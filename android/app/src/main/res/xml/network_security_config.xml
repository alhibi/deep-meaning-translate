<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The app talks to the service over HTTPS only. Cleartext is refused, including
         any accidental http:// provider URL. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
