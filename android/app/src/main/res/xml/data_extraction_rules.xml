<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The archive holds personal sentences. It stays on the device; backups are the
         explicit, user-exported file from Data settings. Nothing is uploaded to a
         cloud backup or transferred to another device by the OS. -->
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
