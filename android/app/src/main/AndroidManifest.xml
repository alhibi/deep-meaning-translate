<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Three permissions, each required by a visible feature: INTERNET for
      translation/speech, RECORD_AUDIO + MODIFY_AUDIO_SETTINGS for dictation (Capacitor
      asks for both in the WebView capture gate). No storage permission: backups go
      through the Storage Access Framework.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Declared where the app uses it (the feel/haptics facade), not left to a plugin's
         manifest: removing @capacitor/haptics must not silently kill vibration. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Approximate location only, requested at runtime after the person opts in to the
         local weather strip. No precise (FINE) location and no background location: the
         forecast needs a city, not a fix. A patch to Capacitor's BridgeWebChromeClient
         makes the WebView permission request coarse-only (patches/@capacitor+android+...).
         Weather failures never affect translation. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Capacitor's WebView permission gate asks for MODIFY_AUDIO_SETTINGS together with
         RECORD_AUDIO for AUDIO_CAPTURE; without it both are denied and dictation can never
         start. It is a normal (non-runtime) permission used only for capture routing. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="false"
        android:theme="@style/AppTheme">

        <!-- The product is one portrait canvas (max-width ~xl, one composer + one answer).
             Landscape compresses the stage below its floors and overlaps the style row, so
             1.0.3 locks the translator to portrait instead of shipping a broken second
             layout. A future landscape/tablet layout must be a deliberate design, not a
             squeezed copy (see docs/android/device-compatibility.md). -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale|fontWeightAdjustment|colorMode"
            android:screenOrientation="portrait"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
